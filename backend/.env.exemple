# Configuration du socle « Dites-le-nous une fois »
# Copier ce fichier en backend/.env, le remplir, puis le rendre lisible par le service seul : chmod 600 backend/.env
# Le fichier .env ne doit JAMAIS être publié (il est exclu du dépôt).

# ── Base de données ───────────────────────────────────────────────────────────
#   sqlite   : un fichier, rien à installer (essai, petite administration)
#   postgres : PostgreSQL, dont Supabase (production)
#   firebase : Firebase Realtime Database (Google)
SOCLE_STOCKAGE=sqlite
#   sqlite   : chemin du fichier, relatif à backend/          ex. donnees/socle.db
#   postgres : postgresql://utilisateur:motdepasse@hote:5432/base
#              Supabase : chaîne « Session pooler » du compte réservé au socle
DATABASE_URL=donnees/socle.db
#   firebase seulement : fichier d'accès (relatif à backend/) et adresse de la base
FIREBASE_CREDENTIALS=
FIREBASE_DB_URL=

# ── Connexion ─────────────────────────────────────────────────────────────────
#   1 = démonstration : le code de connexion s'affiche à l'écran ; 0 = production : il est envoyé par SMS
SOCLE_DEMO=1
#   1 = toute réponse non signée d'une administration est refusée (à activer quand toutes signent)
SIGNATURE_REGISTRE_OBLIGATOIRE=0

# ── Assistant (facultatif) ────────────────────────────────────────────────────
#   aucun             : pas d'assistant (la mascotte n'apparaît pas)
#   anthropic         : Claude                     ASSISTANT_CLE = clé Anthropic
#   compatible-openai : Mistral, Ollama, vLLM…     ASSISTANT_URL = ex. https://api.mistral.ai/v1 ou http://localhost:11434/v1
ASSISTANT_FOURNISSEUR=aucun
ASSISTANT_URL=
ASSISTANT_CLE=
#   nom du modèle (anthropic : claude-haiku-5-5 par défaut ; compatible-openai : obligatoire, ex. mistral-small-latest)
ASSISTANT_MODELE=
